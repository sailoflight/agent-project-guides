{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sailoflight/agent-project-guides/schemas/context-route.schema.json",
  "title": "Agent Project Guides context route",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(role:(production|development)/[a-z0-9-]+|profile:[a-z0-9-]+|overlay:[a-z0-9-]+)$"
    },
    "default": {"$ref": "#/$defs/route"},
    "by_mode": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/route"}
    },
    "full_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "full_budget": {"type": "integer", "minimum": 1}
  },
  "anyOf": [
    {"required": ["default"]},
    {"required": ["by_mode"]}
  ],
  "dependentRequired": {
    "full_modes": ["full_budget"],
    "full_budget": ["full_modes"]
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids", "budget"],
      "properties": {
        "ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "budget": {"type": "integer", "minimum": 0}
      }
    }
  }
}
