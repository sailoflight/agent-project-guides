{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sailoflight/agent-project-guides/schemas/package-manifest.schema.json",
  "title": "Agent Project Guides package manifest",
  "description": "PACKAGE_MANIFEST.json as written by `apg release manifest` from 3.0.11 on. `files[].mode` is the file's POSIX permission mask in decimal (420 = 0o644, 493 = 0o755) and is covered by `digest`. Manifests published before 3.0.11 carry no mode; they stay verifiable on their own shape, but this schema describes the current format only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_version", "files", "digest"],
  "properties": {
    "schema_version": {"const": 1},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "mode", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "mode": {"type": "integer", "minimum": 0, "maximum": 511},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
